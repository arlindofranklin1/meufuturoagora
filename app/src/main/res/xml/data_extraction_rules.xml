<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup e transferência entre aparelhos (Android 12+).
   A sessão do Supabase (sessao_supabase.xml) nunca sai do aparelho: ela é
   cifrada com uma chave do Android Keystore, que não vai no backup, e o
   usuário só precisa entrar de novo no aparelho novo.
   https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sessao_supabase.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sessao_supabase.xml" />
    </device-transfer>
</data-extraction-rules>
