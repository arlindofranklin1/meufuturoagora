<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/degrade_background"
    tools:context=".TelaEntrar">


    <!-- ========================= -->
    <!-- Elemento 1 -->
    <!-- ========================= -->

    <ImageView
        android:id="@+id/elemento1ImageView"
        android:layout_width="215dp"
        android:layout_height="351dp"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/elemento1_tela_entrar"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginTop="-5dp" />


    <!-- ========================= -->
    <!-- Elemento 2 -->
    <!-- ========================= -->

    <ImageView
        android:id="@+id/elemento2ImageView"
        android:layout_width="246dp"
        android:layout_height="322dp"
        android:scaleType="fitCenter"
        android:translationY="29dp"
        app:srcCompat="@drawable/elemento2_tela_entrar"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ========================= -->
    <!-- Elemento 3 -->
    <!-- ========================= -->

    <ImageView
        android:id="@+id/elemento4ImageView"
        android:layout_width="219dp"
        android:layout_height="705dp"
        android:scaleType="fitCenter"
        android:translationY="235dp"
        app:srcCompat="@drawable/elemento3_tela_entrar"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ========================= -->
    <!-- Elemento 4 -->
    <!-- ========================= -->

    <ImageView
        android:id="@+id/elemento5ImageView"
        android:layout_width="106dp"
        android:layout_height="400dp"
        android:scaleType="fitCenter"
        android:translationY="154dp"
        app:srcCompat="@drawable/elemento4_tela_entrar"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <!-- ========================= -->
    <!-- Logo Meu Futuro Agora -->
    <!-- ========================= -->

    <ImageView
        android:id="@+id/logoMeuFuturoAgoraImageView"
        android:layout_width="310dp"
        android:layout_height="135dp"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/logo_meufuturoagora"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"

        android:translationY="-40dp" />


    <!-- ========================= -->
    <!-- Botão Google -->
    <!-- ========================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/googleButton"
        android:layout_width="0dp"
        android:layout_height="50dp"

        android:elevation="8dp"

        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="10dp"
        app:strokeColor="#E0E0E0"
        app:strokeWidth="1dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"

        android:layout_marginStart="65dp"
        android:layout_marginEnd="65dp"
        android:layout_marginTop="555dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:gravity="center"
            android:orientation="horizontal">


            <ImageView
                android:id="@+id/googleImageView"
                android:layout_width="25dp"
                android:layout_height="25dp"

                android:layout_marginEnd="14dp"

                android:scaleType="fitCenter"
                android:src="@drawable/logo_google" />


            <TextView
                android:id="@+id/entrarTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:fontFamily="@font/sf_bold"
                android:text="Entrar com o Google"
                android:textColor="#000000"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ========================= -->
    <!-- Logo Trindade -->
    <!-- ========================= -->

    <ImageView
        android:id="@+id/trindadeImageView"
        android:layout_width="225dp"
        android:layout_height="145dp"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/trindade_logo"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
 />


</androidx.constraintlayout.widget.ConstraintLayout>
