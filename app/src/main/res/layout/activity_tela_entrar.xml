<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/degrade_background"
    tools:context=".TelaEntrar">


    <!-- ========================= -->
    <!-- Elemento 1 -->
    <!-- ========================= -->


    <!-- ========================= -->
    <!-- Elemento 2 -->
    <!-- ========================= -->


    <!-- ========================= -->
    <!-- Elemento 3 -->
    <!-- ========================= -->

    <ImageView
        android:id="@+id/elemento4ImageView"
        android:layout_width="219dp"
        android:layout_height="705dp"
        android:scaleType="fitCenter"
        android:translationY="235dp"
        app:srcCompat="@drawable/elemento3_tela_entrar"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ========================= -->
    <!-- Elemento 4 -->
    <!-- ========================= -->

    <ImageView
        android:id="@+id/elemento5ImageView"
        android:layout_width="106dp"
        android:layout_height="400dp"
        android:scaleType="fitCenter"
        android:translationY="154dp"
        app:srcCompat="@drawable/elemento4_tela_entrar"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <!-- ========================= -->
    <!-- Logo Meu Futuro Agora -->
    <!-- ========================= -->

    <ImageView
        android:id="@+id/logoMeuFuturoAgoraImageView"
        android:layout_width="310dp"
        android:layout_height="180dp"
        android:scaleType="fitCenter"

        app:srcCompat="@drawable/logo_meufuturoagora_branca"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/googleButton"

        android:layout_marginBottom="15dp" />


    <!-- ========================= -->
    <!-- Botão Google -->
    <!-- ========================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/googleButton"
        android:layout_width="0dp"
        android:layout_height="50dp"

        android:elevation="8dp"

        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="10dp"
        app:strokeColor="#E0E0E0"
        app:strokeWidth="1dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"

        android:layout_marginStart="65dp"
        android:layout_marginEnd="65dp"
        android:layout_marginTop="480dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:gravity="center"
            android:orientation="horizontal">


            <ImageView
                android:id="@+id/googleImageView"
                android:layout_width="25dp"
                android:layout_height="25dp"

                android:layout_marginEnd="14dp"

                android:scaleType="fitCenter"
                android:src="@drawable/logo_google" />


            <TextView
                android:id="@+id/entrarTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:fontFamily="@font/poppins_bold"
                android:text="Entrar com o Google"
                android:textColor="#000000"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ========================= -->
    <!-- Acessar como administrador -->
    <!-- ========================= -->

    <TextView
        android:id="@+id/tvAcessarAdministrador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="Acessar como administrador"
        android:textColor="#FFFFFF"
        android:textSize="14sp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/googleButton" />


    <!-- ========================= -->
    <!-- Logo Trindade -->
    <!-- ========================= -->


</androidx.constraintlayout.widget.ConstraintLayout>
