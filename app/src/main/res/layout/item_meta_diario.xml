<?xml version="1.0" encoding="utf-8"?>
<!-- Uma "folhinha" do diário: cor pastel trocada no código -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/folhaMeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_folha_diario"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgBrilhoMeta"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_brilho"
            app:tint="@color/dourado_ranking" />

        <TextView
            android:id="@+id/tvDataMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_semibold"
            android:text="02 de outubro de 2026"
            android:textColor="@color/roxo_primario"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/btnApagarMeta"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Apagar página"
            android:padding="9dp"
            android:src="@drawable/ic_lixeira"
            android:alpha="0.6" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvTextoMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/poppins_regular"
        android:lineSpacingMultiplier="1.1"
        android:text="Quero entrar no curso de Informática e criar meu próprio aplicativo."
        android:textColor="@color/texto_escuro"
        android:textSize="15sp" />

</LinearLayout>
