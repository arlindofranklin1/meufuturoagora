<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".TelaAtividadeAluno">

    <ImageView
        android:id="@+id/btnVoltar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="35dp"
        android:contentDescription="Voltar"
        android:scaleType="centerInside"
        android:src="@drawable/seta_voltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTituloAtividadeAluno"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Atividade"
        android:textColor="@color/roxo_primario"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@id/btnVoltar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnVoltar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnVoltar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp">

            <TextView
                android:id="@+id/tvDescricaoAtividadeAluno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="Descrição da atividade."
                android:textColor="@color/texto_escuro"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Anexo do professor"
                android:textColor="@color/roxo_primario"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/itemAnexoProfessor"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_botao_arquivo"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arquivo" />

                <TextView
                    android:id="@+id/tvNomeAnexoProfessor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_regular"
                    android:maxLines="1"
                    android:text="Nenhum anexo"
                    android:textColor="@color/texto_escuro"
                    android:textSize="14sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Pontuação máxima"
                        android:textColor="@color/roxo_primario"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPontuacaoMaximaAluno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="10 pts"
                        android:textColor="@color/texto_escuro"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Prazo final"
                        android:textColor="@color/roxo_primario"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvPrazoFinalAluno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="00/00/0000"
                        android:textColor="@color/texto_escuro"
                        android:textSize="15sp" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="22dp"
                android:background="@color/linha_cinza" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Sua entrega"
                android:textColor="@color/roxo_primario"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvStatusEntregaAluno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill_vermelho"
                android:fontFamily="@font/poppins_semibold"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="Não entregue"
                android:textColor="@color/vermelho_erro"
                android:textSize="12sp" />

            <!-- ENVIO -->

            <LinearLayout
                android:id="@+id/layoutEnvioAluno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelecionarArquivoAluno"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_botao_arquivo"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_bold"
                    android:maxLines="1"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:text="Selecionar arquivo"
                    android:textAlignment="viewStart"
                    android:textAllCaps="false"
                    android:textColor="@color/texto_escuro"
                    android:textSize="16sp"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_arquivo"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    app:iconSize="25dp"
                    app:iconTint="@null"
                    app:strokeWidth="0dp" />

                <EditText
                    android:id="@+id/edtComentarioAluno"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_campo_criar_atividade"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="top|start"
                    android:hint="Comentário (opcional)"
                    android:inputType="textMultiLine"
                    android:padding="13dp"
                    android:textColor="#171717"
                    android:textColorHint="#171717"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFazerEntrega"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/roxo_primario"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Fazer entrega"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    app:cornerRadius="15dp" />

            </LinearLayout>

            <!-- AVALIAÇÃO -->

            <LinearLayout
                android:id="@+id/layoutAvaliacaoAluno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Nota"
                    android:textColor="@color/roxo_primario"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvNotaAluno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="—"
                    android:textColor="@color/texto_escuro"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Comentário do professor"
                    android:textColor="@color/roxo_primario"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvComentarioProfessorAluno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_campo_criar_atividade"
                    android:fontFamily="@font/poppins_regular"
                    android:minHeight="60dp"
                    android:padding="13dp"
                    android:text="—"
                    android:textColor="@color/texto_escuro"
                    android:textSize="15sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
