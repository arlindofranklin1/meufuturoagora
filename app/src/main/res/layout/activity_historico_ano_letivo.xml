<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <ImageView
        android:id="@+id/btnVoltar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="12dp"
        android:contentDescription="Voltar"
        android:scaleType="centerInside"
        android:src="@drawable/seta_voltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:text="Histórico"
        android:textColor="@color/roxo_primario"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@id/btnVoltar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnVoltar" />

    <!-- FILTROS: ANO LETIVO E BIMESTRE -->

    <LinearLayout
        android:id="@+id/layoutFiltros"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnVoltar">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Ano letivo"
                android:textColor="#171717"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spinnerAnoHistorico"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_campo_criar_atividade"
                android:paddingStart="8dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Período"
                android:textColor="#171717"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spinnerBimestreHistorico"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_campo_criar_atividade"
                android:paddingStart="8dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- FILTRO: TURMA -->

    <LinearLayout
        android:id="@+id/layoutFiltroTurma"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutFiltros">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Turma"
            android:textColor="#171717"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinnerTurmaHistorico"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_campo_criar_atividade"
            android:paddingStart="8dp" />

    </LinearLayout>

    <!-- ABAS -->

    <LinearLayout
        android:id="@+id/layoutAbas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutFiltroTurma">

        <TextView
            android:id="@+id/abaAlunos"
            style="@style/AbaBimestre"
            android:text="Alunos" />

        <TextView
            android:id="@+id/abaTrilhas"
            style="@style/AbaBimestre"
            android:text="Trilhas" />

        <TextView
            android:id="@+id/abaEntregas"
            style="@style/AbaBimestre"
            android:text="Entregas" />

    </LinearLayout>

    <!-- PESQUISA (MESMO ESTILO DA BUSCA DE DISCIPLINAS) -->

    <androidx.cardview.widget.CardView
        android:id="@+id/cardBuscaHistorico"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        app:cardBackgroundColor="#E0E0E0"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutAbas">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingEnd="15dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Buscar"
                android:src="@drawable/ic_busca" />

            <EditText
                android:id="@+id/edtBuscarHistorico"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:fontFamily="@font/poppins_regular"
                android:hint="Buscar alunos"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="#8E8E8E"
                android:textColorHint="#8E8E8E"
                android:textSize="13sp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- RESUMO -->

    <TextView
        android:id="@+id/tvResumoHistorico"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/poppins_regular"
        android:textColor="@color/texto_cinza"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardBuscaHistorico" />

    <ProgressBar
        android:id="@+id/progressHistorico"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="40dp"
        android:indeterminateTint="@color/roxo_primario"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvResumoHistorico" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerHistorico"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvResumoHistorico" />

</androidx.constraintlayout.widget.ConstraintLayout>
