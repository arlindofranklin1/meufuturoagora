<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_calendario" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDescricaoAula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_bold"
                android:maxLines="1"
                android:text="Aula"
                android:textColor="@color/texto_escuro"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvDataAula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="00/00/0000"
                android:textColor="@color/texto_cinza"
                android:textSize="13sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btnMenuAula"
            android:layout_width="30dp"
            android:layout_height="40dp"
            android:contentDescription="Opções"
            android:scaleType="centerInside"
            android:src="@drawable/ic_menu_vertical" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/linha_cinza" />

</LinearLayout>
