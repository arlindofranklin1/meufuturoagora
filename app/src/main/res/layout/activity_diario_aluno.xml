<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".DiarioAlunoActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDiario"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ============================= -->
            <!-- CABEÇALHO MÁGICO -->
            <!-- ============================= -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_diario">

                <!-- Brilhos espalhados -->
                <ImageView
                    android:id="@+id/brilho1"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="52dp"
                    android:layout_marginEnd="34dp"
                    android:alpha="0.9"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_brilho" />

                <ImageView
                    android:id="@+id/brilho2"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="92dp"
                    android:layout_marginEnd="74dp"
                    android:alpha="0.7"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_brilho" />

                <ImageView
                    android:id="@+id/brilho3"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="120dp"
                    android:layout_marginBottom="26dp"
                    android:alpha="0.6"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_brilho" />

                <ImageView
                    android:id="@+id/brilho4"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="210dp"
                    android:layout_marginTop="40dp"
                    android:alpha="0.5"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_brilho" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="50dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="Meu diário"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/tvSaudacaoDiario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="60dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="Um cantinho só seu para sonhar alto."
                        android:textColor="#F2EAFF"
                        android:textSize="15sp" />

                    <!-- Selo de privacidade -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_pill_branco_transparente"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_cadeado" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Só você vê o que escreve aqui"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

            <!-- ============================= -->
            <!-- CARD MEU FUTURO AGORA -->
            <!-- ============================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cardMeuFuturo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="20dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="22dp"
                app:cardElevation="6dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_meu_futuro">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="58dp"
                        android:alpha="0.85"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_brilho" />

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="24dp"
                        android:layout_marginBottom="16dp"
                        android:alpha="0.7"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_brilho" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="18dp">

                        <FrameLayout
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:background="@drawable/bg_circulo_branco"
                            android:backgroundTint="#33FFFFFF">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_brilho" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_bold"
                                android:text="Meu Futuro Agora"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Descubra os cursos do IFSertãoPB – Campus Santa Luzia"
                                android:textColor="#F7F0FF"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/poppins_bold"
                            android:importantForAccessibility="no"
                            android:text="›"
                            android:textColor="#FFFFFF"
                            android:textSize="30sp" />

                    </LinearLayout>

                </FrameLayout>

            </androidx.cardview.widget.CardView>

            <!-- ============================= -->
            <!-- ESCREVER NOVA META -->
            <!-- ============================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="26dp"
                android:fontFamily="@font/poppins_bold"
                android:text="O que você sonha para o futuro?"
                android:textColor="@color/roxo_primario"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Escreva uma meta, um desejo ou um recado para o seu eu do futuro."
                android:textColor="@color/texto_cinza"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_campo_diario"
                android:orientation="vertical"
                android:padding="14dp">

                <EditText
                    android:id="@+id/etNovaMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="top|start"
                    android:hint="Querido diário, um dia eu quero…"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="1000"
                    android:minLines="3"
                    android:textColor="@color/texto_escuro"
                    android:textColorHint="#A99BC4"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvContadorMeta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_regular"
                        android:text="0/1000"
                        android:textColor="#A99BC4"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGuardarMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:fontFamily="@font/poppins_bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="Guardar no diário ✨"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        app:backgroundTint="@color/roxo_primario"
                        app:cornerRadius="14dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ============================= -->
            <!-- MINHAS METAS -->
            <!-- ============================= -->

            <TextView
                android:id="@+id/tvTituloMetas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="26dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Minhas páginas"
                android:textColor="@color/roxo_primario"
                android:textSize="17sp" />

            <LinearLayout
                android:id="@+id/containerMetas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="20dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/layoutDiarioVazio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_diario_ativo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:text="Seu diário ainda está em branco"
                    android:textColor="@color/texto_escuro"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:text="Toda grande história começa com a primeira página."
                    android:textColor="@color/texto_cinza"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/linhaBottomBar"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="#737373"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:minHeight="64dp"
        app:itemActiveIndicatorStyle="@style/BottomNavigationActiveIndicator"
        app:itemHorizontalTranslationEnabled="false"
        app:itemIconSize="24dp"
        app:itemIconTint="@null"
        app:itemTextAppearanceActive="@style/BottomNavigationText"
        app:itemTextAppearanceInactive="@style/BottomNavigationText"
        app:itemTextColor="@color/bottom_navigation_text"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_aluno"
        app:paddingBottomSystemWindowInsets="false" />

</androidx.constraintlayout.widget.ConstraintLayout>
