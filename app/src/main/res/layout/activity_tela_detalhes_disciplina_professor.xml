<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".TelaDetalhesDisciplinaProfessor">

    <!-- TÍTULO -->

    <ImageView
        android:id="@+id/btnVoltar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="35dp"
        android:src="@drawable/seta_voltar"
        android:scaleType="centerInside"
        android:contentDescription="Voltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvNomeDisciplina"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:gravity="center"
        android:text="Português"
        android:textColor="@color/roxo_primario"
        android:textSize="20sp"
        android:fontFamily="@font/poppins_bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnVoltar"
        app:layout_constraintBottom_toBottomOf="@id/btnVoltar" />

    <!-- ABAS -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutAbas"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/btnVoltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tabAtividades"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Atividades"
            android:textColor="@color/roxo_primario"
            android:layout_marginStart="20dp"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tabAlunos"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tabAlunos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Alunos"
            android:textColor="#171717"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_bold"
            app:layout_constraintStart_toEndOf="@id/tabAtividades"
            app:layout_constraintEnd_toStartOf="@id/tabFrequencia"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tabFrequencia"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Frequência"
            android:textColor="#171717"
            android:layout_marginEnd="20dp"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_bold"
            app:layout_constraintStart_toEndOf="@id/tabAlunos"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- LINHA DA ABA ATIVA -->

        <View
            android:id="@+id/linhaAbaAtividades"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/roxo_primario"
            app:layout_constraintStart_toStartOf="@id/tabAtividades"
            app:layout_constraintEnd_toEndOf="@id/tabAtividades"
            app:layout_constraintBottom_toBottomOf="parent" />

        <View
            android:id="@+id/linhaAbaAlunos"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/roxo_primario"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/tabAlunos"
            app:layout_constraintEnd_toEndOf="@id/tabAlunos"
            app:layout_constraintBottom_toBottomOf="parent" />

        <View
            android:id="@+id/linhaAbaFrequencia"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/roxo_primario"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/tabFrequencia"
            app:layout_constraintEnd_toEndOf="@id/tabFrequencia"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- LINHA SEPARADORA -->

    <View
        android:id="@+id/linhaSeparadora"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#AAAAAA"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/layoutAbas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- LISTA DE ATIVIDADES -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAtividades"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="5dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/linhaSeparadora"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- LISTA DE ALUNOS -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAlunos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/linhaSeparadora"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSemAlunosDisciplina"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_regular"
        android:text="Nenhum aluno matriculado ainda."
        android:textColor="@color/texto_cinza"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/linhaSeparadora"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- AÇÕES DE FREQUÊNCIA -->

    <LinearLayout
        android:id="@+id/layoutFrequenciaAcoes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="15dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/linhaSeparadora"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/itemCadastrarAula"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_calendario" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="Cadastrar aula"
                android:textColor="@color/texto_escuro"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:rotation="180"
                android:src="@drawable/seta_voltar" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/linha_cinza" />

        <LinearLayout
            android:id="@+id/itemRegistrarFrequencia"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_check_circle" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="Registrar frequência"
                android:textColor="@color/texto_escuro"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:rotation="180"
                android:src="@drawable/seta_voltar" />

        </LinearLayout>

    </LinearLayout>

    <!-- BOTÃO CRIAR ATIVIDADE -->

    <ImageButton
        android:id="@+id/btnAdicionarAtividade"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:src="@drawable/ic_mais"
        android:scaleType="centerInside"
        android:padding="16dp"
        android:contentDescription="Criar atividade"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>