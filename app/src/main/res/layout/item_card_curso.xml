<?xml version="1.0" encoding="utf-8"?>
<!-- Card de curso no padrão dos cards da tela inicial (cores aplicadas no código) -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardCurso"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginTop="16dp"
    android:layout_marginEnd="20dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- FUNDO CURVO -->
        <ImageView
            android:id="@+id/imgCurvaCurso"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/bg_curva_curso" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="170dp"
            android:paddingStart="24dp"
            android:paddingEnd="20dp">

            <!-- ÍCONE: círculo claro com quadrado colorido -->
            <FrameLayout
                android:id="@+id/circuloCurso"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_circulo_branco"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/imgIconeCurso"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_quadrado_arredondado"
                    android:importantForAccessibility="no"
                    android:padding="7dp"
                    android:src="@drawable/ic_curso_informatica" />

            </FrameLayout>

            <!-- TÍTULO -->
            <TextView
                android:id="@+id/tvNomeCurso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:fontFamily="@font/poppins_bold"
                android:lineSpacingMultiplier="0.9"
                android:text="Informática"
                android:textSize="21sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/circuloCurso"
                app:layout_constraintTop_toTopOf="@id/circuloCurso" />

            <!-- SUBTÍTULO -->
            <TextView
                android:id="@+id/tvResumoCurso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Programação, sites e aplicativos"
                android:textColor="#777777"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/circuloCurso"
                app:layout_constraintTop_toBottomOf="@id/tvNomeCurso" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barreiraTopoCurso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="circuloCurso,tvResumoCurso" />

            <!-- INFORMAÇÃO DE BAIXO -->
            <TextView
                android:id="@+id/tvInfoCurso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="18dp"
                app:layout_constraintTop_toBottomOf="@id/barreiraTopoCurso"
                app:layout_constraintVertical_bias="1"
                android:fontFamily="@font/poppins_bold"
                android:text="3 anos • Integrado ao Médio"
                android:textColor="@color/texto_escuro"
                android:textSize="15sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

</androidx.cardview.widget.CardView>
