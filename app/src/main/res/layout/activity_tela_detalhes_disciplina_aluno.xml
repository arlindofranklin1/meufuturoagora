<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".TelaDetalhesDisciplinaAluno">

    <ImageView
        android:id="@+id/btnVoltar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="35dp"
        android:src="@drawable/seta_voltar"
        android:scaleType="centerInside"
        android:contentDescription="Voltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvNomeDisciplinaAluno"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:gravity="center"
        android:text="Português"
        android:textColor="@color/roxo_primario"
        android:textSize="20sp"
        android:fontFamily="@font/poppins_bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnVoltar"
        app:layout_constraintBottom_toBottomOf="@id/btnVoltar" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutAbasAluno"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/btnVoltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tabTodos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Todos"
            android:textColor="@color/roxo_primario"
            android:layout_marginStart="10dp"
            android:textSize="15sp"
            android:fontFamily="@font/poppins_bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tabEntregues"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tabEntregues"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Entregues"
            android:textColor="#171717"
            android:textSize="15sp"
            android:fontFamily="@font/poppins_bold"
            app:layout_constraintStart_toEndOf="@id/tabTodos"
            app:layout_constraintEnd_toStartOf="@id/tabAvaliadas"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tabAvaliadas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Avaliadas"
            android:textColor="#171717"
            android:layout_marginEnd="10dp"
            android:textSize="15sp"
            android:fontFamily="@font/poppins_bold"
            app:layout_constraintStart_toEndOf="@id/tabEntregues"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <View
            android:id="@+id/linhaAbaTodos"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/roxo_primario"
            app:layout_constraintStart_toStartOf="@id/tabTodos"
            app:layout_constraintEnd_toEndOf="@id/tabTodos"
            app:layout_constraintBottom_toBottomOf="parent" />

        <View
            android:id="@+id/linhaAbaEntregues"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/roxo_primario"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/tabEntregues"
            app:layout_constraintEnd_toEndOf="@id/tabEntregues"
            app:layout_constraintBottom_toBottomOf="parent" />

        <View
            android:id="@+id/linhaAbaAvaliadas"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/roxo_primario"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/tabAvaliadas"
            app:layout_constraintEnd_toEndOf="@id/tabAvaliadas"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/linhaSeparadoraAluno"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/linha_cinza"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/layoutAbasAluno"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAtividadesAluno"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="5dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/linhaSeparadoraAluno"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSemAtividadesDisciplinaAluno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_regular"
        android:text="Nenhuma atividade nesta categoria."
        android:textColor="@color/texto_cinza"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/linhaSeparadoraAluno"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
