<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".CadastrarAulaActivity">

    <ImageView
        android:id="@+id/btnVoltar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="35dp"
        android:contentDescription="Voltar"
        android:scaleType="centerInside"
        android:src="@drawable/seta_voltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:text="Cadastrar aula"
        android:textColor="@color/roxo_primario"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@id/btnVoltar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnVoltar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnVoltar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="30dp">

            <EditText
                android:id="@+id/edtQuantidadeAulas"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_campo_criar_atividade"
                android:fontFamily="@font/poppins_regular"
                android:hint="Quantidade de aulas"
                android:inputType="number"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:singleLine="true"
                android:textColor="#171717"
                android:textColorHint="#171717"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/edtDescricaoAula"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_campo_criar_atividade"
                android:fontFamily="@font/poppins_regular"
                android:gravity="top|start"
                android:hint="Descrição"
                android:inputType="textMultiLine"
                android:padding="13dp"
                android:textColor="#171717"
                android:textColorHint="#171717"
                android:textSize="16sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/edtDataAula"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_campo_criar_atividade"
                    android:focusable="false"
                    android:fontFamily="@font/poppins_regular"
                    android:hint="Data"
                    android:paddingStart="13dp"
                    android:paddingEnd="40dp"
                    android:textColor="#171717"
                    android:textColorHint="#171717"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="Selecionar data"
                    android:src="@drawable/ic_calendario" />

            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSalvarAula"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="@color/roxo_primario"
                android:fontFamily="@font/poppins_bold"
                android:text="Salvar"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                app:cornerRadius="15dp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
